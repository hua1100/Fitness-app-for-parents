# 資料庫連線
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitness_app_dev"

# JWT 密鑰（請更換為隨機字串）
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 加密密鑰（32 bytes hex）
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 伺服器設定
PORT=3000
NODE_ENV=development

# Firebase（推播通知）
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"

# AWS S3（語音檔案儲存）
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="fitness-app-voices-dev"
AWS_S3_CDN_URL="https://cdn.your-domain.com"

# Redis（選用，用於快取）
REDIS_URL="redis://localhost:6379"

# CORS 設定
CORS_ORIGIN="http://localhost:3000,http://localhost:19000,http://localhost:8081"

# Line Login
LINE_CHANNEL_ID="your-line-channel-id"
LINE_CHANNEL_SECRET="your-line-channel-secret"
LINE_CALLBACK_URL="http://localhost:3000/api/oauth/line/callback"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/oauth/google/callback"

# 日誌等級
LOG_LEVEL="debug"

# Sentry（錯誤追蹤，選用）
SENTRY_DSN=""

# 信件服務（密碼重設用）
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
EMAIL_FROM="noreply@fitness-app.com"
