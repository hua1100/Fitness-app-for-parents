# API 端點
API_URL=http://localhost:3000/v1

# WebSocket 端點
WEBSOCKET_URL=http://localhost:3000

# Firebase 配置（推播通知）
FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
FIREBASE_APP_ID="your-app-id"

# 環境
ENV=development

# 日誌等級
LOG_LEVEL=debug

# Sentry（錯誤追蹤，選用）
SENTRY_DSN=""

# 語音配置
VOICE_MAX_DURATION_SECONDS=30
VOICE_MAX_FILE_SIZE_MB=5
VOICE_MAX_COUNT_PER_ELDER=20

# 通知配置
NOTIFICATION_EXERCISE_DELAY_SECONDS=30
NOTIFICATION_INACTIVITY_DAYS=3
NOTIFICATION_EMERGENCY_TIMEOUT_SECONDS=30

# 離線同步配置
SYNC_RETRY_INTERVAL_MS=60000
SYNC_MAX_RETRY_COUNT=3
OFFLINE_DATA_RETENTION_DAYS=7
